    "Authentication failed. Please sign in to Claude Code again." : {
      "comment" : "Error: HTTP 401 authentication failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizierung fehlgeschlagen. Bitte melden Sie sich erneut bei Claude Code an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticación fallida. Por favor, inicia sesión en Claude Code nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'authentification. Veuillez vous reconnecter à Claude Code."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रमाणीकरण विफल। कृपया Claude Code में पुनः साइन इन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentikasi gagal. Silakan masuk ke Claude Code lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticazione fallita. Effettua nuovamente l'accesso a Claude Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証に失敗しました。Claude Code に再サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증 실패. Claude Code에 다시 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na autenticação. Por favor, faça login novamente no Claude Code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認證失敗，請重新登入 Claude Code"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認證失敗，請重新登入 Claude Code"
          }
        }
